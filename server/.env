PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atscorps
DB_USER=postgres
DB_PASSWORD=postgres
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# JWT — change JWT_SECRET to a random 64-char hex string before deploying
JWT_SECRET=a3f8c2d1e9b4057a6c8d3f2e1b9a4057c6d8e3f2a1b9c4d7e0f3a2b5c8d1e4f7

# Admin credentials
# ADMIN_PASSWORD_HASH is auto-generated from ADMIN_PASSWORD on first startup.
# After first run, copy the logged hash here and remove ADMIN_PASSWORD.
ADMIN_EMAIL=admin@atscorps.com
ADMIN_PASSWORD=admin@123

# Razorpay — replace with real keys from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_live_T2fLggzDXfcmPY
RAZORPAY_KEY_SECRET=5caEca95C1KycNEl18daJ0L0

# MSG91 SMS OTP — fill both AUTH_KEY and OTP_TEMPLATE_ID to enable real SMS.
# Leave blank to stay in demo mode (OTP returned in API response).
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# Developer bypass — set to false before deploying to production
DEV_BYPASS=true
