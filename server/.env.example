# ── Server configuration ─────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.

PORT=4000
NODE_ENV=development            # set to "production" on Render

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atscorps
DB_USER=postgres
DB_PASSWORD=postgres

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a 64-char hex secret:  openssl rand -hex 32
JWT_SECRET=replace-with-a-64-char-random-hex-string

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ── Admin account ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@atscorps.com
ADMIN_PASSWORD=change-me-min-8-chars
# After first boot, copy the logged ADMIN_PASSWORD_HASH here and remove ADMIN_PASSWORD.

# ── Razorpay (payments) ───────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── MSG91 (SMS OTP) ───────────────────────────────────────────────────────
# When AUTH_KEY + OTP_TEMPLATE_ID are both set, OTPs are sent by SMS.
# Leave blank to run in demo mode (OTP returned in the API response instead).
#   AUTH_KEY        — MSG91 dashboard → Settings → API → Auth Key
#   OTP_TEMPLATE_ID — MSG91 → OTP → an approved DLT template with a ##OTP## var
#   SENDER_ID       — optional 6-char DLT-approved header (e.g. ATSCRP)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# ── Dev only ──────────────────────────────────────────────────────────────
DEV_BYPASS=false               # MUST be false in production
