# ── Frontend environment ─────────────────────────────────────────────
# Every VITE_* value is baked into the public bundle at build time.
# Never put a secret here — only values that are safe to publish.

# Backend API origin, no trailing slash
VITE_API_URL=https://your-api.onrender.com

# Razorpay PUBLIC key id. The matching KEY_SECRET is server-only
# and must never appear in this file.
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Google OAuth client id (public by design).
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add your site to "Authorised JavaScript origins".
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
